        "operation": "executeQuery",
        "query": "SELECT\n  jr.talent_id,\n  jr.job_id\nFROM job_recommendations jr\nWHERE NOT EXISTS (\n  SELECT 1 FROM notifications n\n  WHERE n.user_id = jr.talent_id\n    AND n.data->'new_job_ids' ? jr.job_id::text\n)\nAND NOT EXISTS (\n  SELECT 1 FROM user_seen_jobs s\n  WHERE s.talent_id = jr.talent_id\n    AND s.job_id = jr.job_id\n)",
