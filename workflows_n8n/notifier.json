        "query": "INSERT INTO notifications (\n  user_id,\n  type,\n  title,\n  message,\n  data,\n  is_read,\n  created_at\n)\nVALUES (\n  {{ $json.talent_id }},\n  'new_recommendations',\n  '{{ $json.new_count }} nouvelle' ||\n  CASE WHEN {{ $json.new_count }} > 1 THEN 's' ELSE '' END ||\n  ' offre' ||\n  CASE WHEN {{ $json.new_count }} > 1 THEN 's' ELSE '' END ||\n  ' pour vous',\n\n  'De nouvelles opportunités correspondent à votre profil.',\n\n  jsonb_build_object(\n    'new_job_ids',\n    '{{ JSON.stringify($json.new_ids) }}'::jsonb\n  ),\n\n  false,\n\n  NOW()\n)\nON CONFLICT DO NOTHING;",
