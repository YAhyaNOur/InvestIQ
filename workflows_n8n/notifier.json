    {
      "parameters": {
        "jsCode": "const recos = $('Lire les recos non notifiées').all();\n\nconst recosMap = new Map();\nfor (const item of recos) {\n  const tId = item.json.talent_id;\n  const jId = item.json.job_id;\n  if (!recosMap.has(tId)) recosMap.set(tId, new Set());\n  recosMap.get(tId).add(jId);\n}\n\nconst results = [];\nfor (const [tId, recJobs] of recosMap.entries()) {\n  const newIds = Array.from(recJobs);\n  if (newIds.length === 0) continue;\n  results.push({\n    talent_id: tId,\n    new_ids: newIds,\n    new_count: newIds.length\n  });\n}\n\nreturn results;"
      },
