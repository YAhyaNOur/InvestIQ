        "sendTo": "={{ $json.investor_email }}",
        "subject": "=SmartStart Analysis: {{ $json.company_name }} — {{ $json.decision }}",
        "message": "=<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n</head>\n\n<body style=\"margin:0;padding:0;background:#f8fafc;font-family:Arial,sans-serif\">\n\n<div style=\"max-width:600px;margin:0 auto;background:white;border-radius:12px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,0.08)\">\n\n  <!-- HEADER -->\n  <div style=\"background:linear-gradient(135deg,#667eea,#764ba2);padding:32px;text-align:center;color:white\">\n    <div style=\"font-size:28px;margin-bottom:8px\">📊</div>\n    <h1 style=\"margin:0;font-size:22px\">Investment Analysis Report</h1>\n    <p style=\"margin:8px 0 0;opacity:0.85;font-size:14px\">AI-powered by SmartStart</p>\n  </div>\n\n  <!-- BODY -->\n  <div style=\"padding:28px\">\n\n    <p style=\"color:#475569;font-size:14px;margin-bottom:24px\">\n      Hello <strong>{{ $json.investor_name }}</strong>,<br><br>\n      Analysis completed for <strong style=\"color:#667eea\">{{ $json.company_name }}</strong>.\n    </p>\n\n    <!-- COMPANY -->\n    <div style=\"background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:16px;margin-bottom:24px\">\n      <div style=\"font-size:18px;font-weight:700\">🏢 {{ $json.company_name }}</div>\n      <div style=\"margin-top:8px\">\n        <span style=\"background:#eff6ff;color:#3b82f6;padding:3px 12px;border-radius:6px;font-size:12px;margin-right:6px\">\n          {{ $json.sector }}\n        </span>\n        <span style=\"background:#f0fdf4;color:#10b981;padding:3px 12px;border-radius:6px;font-size:12px\">\n          {{ $json.region }}\n        </span>\n      </div>\n    </div>\n\n    <!-- SCORES -->\n    <div style=\"margin-bottom:24px\">\n      <h3 style=\"font-size:13px;color:#94a3b8;text-transform:uppercase;margin-bottom:16px\">\n        Score Breakdown\n      </h3>\n\n      <!-- Growth -->\n      <div style=\"margin-bottom:16px\">\n        <div style=\"display:flex;justify-content:space-between;margin-bottom:6px\">\n          <span style=\"font-size:13px;font-weight:600\">📈 Growth Score</span>\n          <span style=\"font-size:16px;font-weight:700;color:{{ $json.growth_color }}\">\n            {{ $json.growth_score }}%\n          </span>\n        </div>\n        <div style=\"height:12px;background:#f1f5f9;border-radius:6px;overflow:hidden\">\n          <div style=\"height:100%;width:{{ $json.growth_bar }}%;background:{{ $json.growth_color }}\"></div>\n        </div>\n        <div style=\"font-size:11px;color:#94a3b8;margin-top:4px\">\n          {{ $json.growth_label }}\n        </div>\n      </div>\n\n      <!-- Risk -->\n      <div style=\"margin-bottom:16px\">\n        <div style=\"display:flex;justify-content:space-between;margin-bottom:6px\">\n          <span style=\"font-size:13px;font-weight:600\">⚠️ Risk Score</span>\n          <span style=\"font-size:16px;font-weight:700;color:{{ $json.risk_color }}\">\n            {{ $json.risk_score }}%\n          </span>\n        </div>\n        <div style=\"height:12px;background:#f1f5f9;border-radius:6px;overflow:hidden\">\n          <div style=\"height:100%;width:{{ $json.risk_bar }}%;background:{{ $json.risk_color }}\"></div>\n        </div>\n        <div style=\"font-size:11px;color:#94a3b8;margin-top:4px\">\n          {{ $json.risk_label }}\n        </div>\n      </div>\n\n      <!-- Opportunity -->\n      <div>\n        <div style=\"display:flex;justify-content:space-between;margin-bottom:6px\">\n          <span style=\"font-size:13px;font-weight:600\">⭐ Opportunity Score</span>\n          <span style=\"font-size:16px;font-weight:700;color:#667eea\">\n            {{ $json.opportunity_score }}%\n          </span>\n        </div>\n        <div style=\"height:12px;background:#f1f5f9;border-radius:6px;overflow:hidden\">\n          <div style=\"height:100%;width:{{ $json.opp_bar }}%;background:linear-gradient(90deg,#667eea,#764ba2)\"></div>\n        </div>\n      </div>\n    </div>\n\n    <!-- DETAILS -->\n    <table style=\"width:100%;border-collapse:collapse;font-size:13px;margin-bottom:24px\">\n      <tr style=\"background:#f8fafc\">\n        <td style=\"padding:10px;border:1px solid #e2e8f0;color:#64748b\">Beta</td>\n        <td style=\"padding:10px;border:1px solid #e2e8f0;font-weight:700\">{{ $json.beta }}</td>\n        <td style=\"padding:10px;border:1px solid #e2e8f0;color:#64748b\">{{ $json.beta_label }}</td>\n      </tr>\n    </table>\n\n    <!-- DISCLAIMER -->\n    <div style=\"background:#fffbeb;border:1px solid #fde68a;border-radius:10px;padding:14px;font-size:12px;color:#92400e\">\n      <strong>⚡ Disclaimer:</strong> AI analysis only — this is not financial advice.\n    </div>\n\n  </div>\n\n  <!-- FOOTER -->\n  <div style=\"background:#f8fafc;padding:20px;text-align:center;border-top:1px solid #e2e8f0\">\n    <div style=\"font-size:16px;font-weight:700;color:#667eea\">SmartStart</div>\n    <p style=\"font-size:12px;color:#94a3b8;margin:4px 0 0\">\n      AI-powered Investment Intelligence\n    </p>\n  </div>\n\n</div>\n\n</body>\n</html>",
