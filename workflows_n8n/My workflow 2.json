    {
      "parameters": {
        "jsCode": "const data = $input.first().json.body || $input.first().json;\n\nconst growthScore = parseFloat(data.growth_score) || 0;\nconst riskScore = parseFloat(data.risk_score) || 0;\n\n// score global neutre (pas de BUY/REJECT)\nconst opportunityScore = Math.max(0, Math.round(growthScore - riskScore / 2));\n\nreturn [{\n  json: {\n    // Original data\n    company_name: data.company_name || 'Unknown',\n    investor_name: data.investor_name || 'Investor',\n    investor_email: data.investor_email || '',\n    growth_score: growthScore,\n    risk_score: riskScore,\n    sector: data.sector || 'N/A',\n    region: data.region || 'N/A',\n    beta: data.beta || 'N/A',\n    ebitda: data.ebitda || 'N/A',\n\n    // Computed\n    opportunity_score: opportunityScore,\n\n    // Growth styling\n    growth_color: growthScore > 60 ? '#10b981' : growthScore > 40 ? '#f59e0b' : '#ef4444',\n    growth_label: growthScore > 60 ? 'Strong Growth' : growthScore > 40 ? 'Moderate Growth' : 'Weak Growth',\n    growth_bar: Math.min(growthScore, 100),\n\n    // Risk styling\n    risk_color: riskScore < 40 ? '#10b981' : riskScore < 60 ? '#f59e0b' : '#ef4444',\n    risk_label: riskScore < 40 ? 'Low Risk' : riskScore < 60 ? 'Medium Risk' : 'High Risk',\n    risk_bar: Math.min(riskScore, 100),\n\n    // Beta\n    beta_label: parseFloat(data.beta) < 1\n      ? 'Stable'\n      : parseFloat(data.beta) < 1.5\n      ? 'Moderate'\n      : 'Volatile',\n\n    // Opportunity bar\n    opp_bar: Math.min(Math.max(0, opportunityScore), 100),\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
